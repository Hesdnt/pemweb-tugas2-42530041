<%- include('partials/navbar') %>
<div class="wrap page">
  <section class="prose">
    <h1>Tambah film</h1>
    <form action="/tambah" method="POST" class="form">
      <label for="judul">Judul film</label>
      <input type="text" id="judul" name="judul" required>

      <label for="sutradara">Sutradara</label>
      <input type="text" id="sutradara" name="sutradara" required>

      <label for="tahun">Tahun rilis</label>
      <input type="number" id="tahun" name="tahun" min="1888" max="2100" required>

      <label for="genre">Genre</label>
      <select id="genre" name="genre" required>
        <option value="">Pilih genre</option>
        <% genres.forEach(function(g) { %>
          <option value="<%= g %>"><%= g %></option>
        <% }); %>
      </select>

      <label for="sinopsis">Deskripsi singkat (sinopsis)</label>
      <textarea id="sinopsis" name="sinopsis" rows="4" required></textarea>

      <label for="poster">Link poster (opsional)</label>
      <input type="text" id="poster" name="poster" placeholder="/images/nama-file.jpg atau https://...">

      <button type="submit" class="btn">Simpan film</button>
    </form>
  </section>
</div>
<%- include('partials/footer') %>
