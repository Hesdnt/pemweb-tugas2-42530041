<%- include('partials/navbar') %>
<div class="wrap page">
  <a class="back" href="/">&larr; Semua film</a>
  <article class="detail">
    <div class="detail-poster poster">
      <img src="<%= film.poster %>" alt="Poster film <%= film.judul %>">
    </div>
    <div class="detail-info">
      <span class="tag"><%= film.genre %></span>
      <h1><%= film.judul %></h1>
      <dl>
        <div><dt>Sutradara</dt><dd><%= film.sutradara %></dd></div>
        <div><dt>Tahun rilis</dt><dd><%= film.tahun %></dd></div>
      </dl>
      <h2>Sinopsis</h2>
      <p class="synopsis"><%= film.sinopsis %></p>
    </div>
  </article>
</div>
<%- include('partials/footer') %>
